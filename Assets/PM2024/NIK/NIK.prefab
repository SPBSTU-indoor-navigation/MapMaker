  id: 
  localizedName:
    ru: "\u0413.3.41 \u0426\u0435\u043D\u0442\u0440 \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0446\u0438\u0439
      \u043F\u043E \u0431\u0435\u0440\u0435\u0436\u043B\u0438\u0432\u043E\u043C\u0443
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443 \"\u041B\u0438\u043D-\u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F\".
      \u043A\u0430\u0444\u0435\u0434\u0440\u0430 \u042E\u041D\u0415\u0421\u041A\u041E
      \"\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445
      \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0433\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F\""
    en: "\u0413.3.41 Lean Production Laboratory. UNESCO Department \"Education quality
      management for sustainable development\""
